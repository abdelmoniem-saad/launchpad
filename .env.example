# Copy to .env and adjust. Placeholder values only; never commit real keys.

# Local open-weight model served by Ollama (no paid service needed)
OLLAMA_HOST=http://ollama:11434
LLM_MODEL=qwen3:8b

# Where the pipeline writes its results
OUTPUT_DIR=outputs
DECISION_LOG=decision_log.json
STATE_DIR=data

# Payments always run MOCKED in this build. A real provider would use test-mode keys only.
PAYMENTS_MODE=mock
PAYMENT_PROVIDER_TEST_KEY=sk_test_placeholder
