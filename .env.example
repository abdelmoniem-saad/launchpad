# Copy to .env and adjust. Placeholder values only; never commit real keys.

# Local open-weight model via Ollama (default, keyless). Smaller machines: qwen3:4b. Larger: gpt-oss:20b.
LOCAL_MODEL=qwen3:8b
OLLAMA_HOST=http://127.0.0.1:11434

# Optional fast mode on the Groq free tier (open-weight gpt-oss-120b). Leave empty to stay fully local.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Self-hosted SearXNG (set automatically in docker compose). Empty = ddgs / Hacker News / Wikipedia fallback.
SEARXNG_URL=

# 1 = fast mode (one department panel per step); 0 = full department review and negotiation
FAST_MODE=1

OUTPUT_DIR=outputs
DECISION_LOG=decision_log.json
STATE_DIR=data
